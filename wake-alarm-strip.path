[Unit]
Description=Show the morning-session strip whenever the signed session file is rewritten
Documentation=https://github.com/kuhyx/wake-alarm

[Path]
# wake-alarm-session.timer rewrites this every 2 min through the morning (and
# the strip itself asks for a refresh every 30 s while it is up). Starting a
# service that is already running is a no-op, so the rewrites cost nothing;
# once the session is over the strip exits 0 at once.
PathChanged=%h/.local/state/wake_alarm/morning_session.json
Unit=wake-alarm-strip.service

[Install]
WantedBy=paths.target
