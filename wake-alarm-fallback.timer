[Unit]
Description=Wake Alarm PC fallback alarm, once a minute through the morning
Documentation=https://github.com/kuhyx/wake-alarm

[Timer]
# 04:00-09:59 covers A-5min..A+45min for any alarm the phone can set (A is
# clamped to <= 08:00). Outside that window a tick reads only local files.
OnCalendar=*-*-* 04..09:*:00
AccuracySec=1s
# Catch up at once after the RTC resume or a boot.
Persistent=true

[Install]
WantedBy=timers.target
